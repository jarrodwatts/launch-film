#!/usr/bin/env bash
# Runs a Python script with the project's venv, isolated (-I), with the tools from env.sh exported.
# Usage: scripts/py scripts/mix.py ...
. "$(dirname "$0")/env.sh"
if [ ! -x "$PY" ]; then echo "No Python venv in .tools/venv: run npm run setup." >&2; exit 1; fi
exec "$PY" -I "$@"
